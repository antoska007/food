/* ============ РАСЧЁТЫ ============ */

function bmr(sex, w, h, a){
  return sex === 'm'
    ? 10*w + 6.25*h - 5*a + 5
    : 10*w + 6.25*h - 5*a - 161;
}

function pick(list, targetKcal, used){
  const cands = [];
  for (const r of list){
    for (let s = 0.5; s <= 2.001; s += 0.25){
      cands.push({ r, s, err: Math.abs(r.k * s - targetKcal) });
    }
  }
  cands.sort((x, y) => x.err - y.err);
  let pool = cands.filter(c => !used.includes(c.r.n)).slice(0, 6);
  if (!pool.length) pool = cands.slice(0, 6);
  return pool[Math.floor(Math.random() * pool.length)];
}

function fmtQty(v){
  if (v >= 20) return Math.round(v / 5) * 5;
  if (v >= 5)  return Math.round(v);
  return Math.round(v * 10) / 10;
}

function round5(x){ return Math.round(x/5)*5; }

/* ============ ГЕНЕРАЦИЯ ПЛАНА ============ */

let STATE = null;

function buildPlan(){
  const sex    = document.querySelector('input[name="sex"]:checked').value;
  const age    = +document.getElementById('age').value;
  const weight = +document.getElementById('weight').value;
  const height = +document.getElementById('height').value;
  const act    = +document.getElementById('activity').value;
  const goal   = parseFloat(document.getElementById('goal').value) || null;
  const weeks  = parseInt(document.getElementById('weeks').value) || null;

  const b = bmr(sex, weight, height, age);
  const tdee = b * act;

  // Целевая калорийность
  let target;
  if (goal && weeks && goal < weight){
    const needDeficit = (weight - goal) * 7700 / (weeks * 7);
    target = tdee - needDeficit;
  } else {
    target = tdee * 0.8; // дефолт: дефицит 20%
  }
  const floorKcal = Math.max(b * 1.1, sex === 'm' ? 1500 : 1200);
  const maxDeficit = tdee * 0.25;
  const rawTarget = target;
  target = Math.max(target, tdee - maxDeficit);
  target = Math.max(target, floorKcal);
  target = Math.min(target, tdee);
  target = round5(target);

  // БЖУ
  let protein = Math.min(1.8 * weight, 0.40 * target / 4);
  let fat     = Math.min(0.9 * weight, 0.35 * target / 9);
  let carbs   = Math.max(0, (target - protein*4 - fat*9) / 4);
  protein = Math.round(protein);
  fat     = Math.round(fat);
  carbs   = Math.round(carbs);

  // Предупреждение о нереалистичном сроке
  const weeklyLoss = (tdee - target) * 7 / 7700;
  const wantedLoss = (goal && weeks && goal < weight) ? (weight - goal) / weeks : null;
  let warning = null;
  if (wantedLoss && wantedLoss > weight * 0.01){
    warning = `Сбросить ${(weight-goal).toFixed(1)} кг за ${weeks} нед. — это ~${wantedLoss.toFixed(2)} кг в неделю. Безопасный темп — до 1% массы тела (${(weight*0.01).toFixed(2)} кг/нед), то есть примерно ${Math.ceil((weight-goal)/(weight*0.01))} недель. План скорректирован в сторону безопасного дефицита.`;
  } else if (rawTarget < floorKcal){
    warning = `Расчётный дефицит слишком большой, калорийность поднята до безопасного минимума (${Math.round(floorKcal)} ккал).`;
  }

  // Распределение калорий по приёмам пищи
  const shares = { breakfast:0.27, lunch:0.33, dinner:0.30, snack:0.10 };
  const used = [];
  const meals = [];

  for (const key of ['breakfast','lunch','dinner']){
    const p = pick(RECIPES[key], target * shares[key], used);
    used.push(p.r.n);
    meals.push({ key, ...p });
  }
  const spent = meals.reduce((s,m) => s + m.r.k * m.s, 0);
  const snackTarget = Math.max(90, target - spent);
  const sp = pick(RECIPES.snack, snackTarget, used);
  meals.push({ key:'snack', ...sp });

  const totalKcal = meals.reduce((s,m) => s + m.r.k * m.s, 0);

  STATE = { sex, age, weight, height, act, goal, weeks,
            b:Math.round(b), tdee:Math.round(tdee), target,
            protein, fat, carbs, weeklyLoss, warning, meals, totalKcal };
  render();
}

/* ============ ОТРИСОВКА ============ */

const TITLES = { breakfast:"Завтрак", lunch:"Обед", dinner:"Ужин", snack:"Перекус" };

function render(){
  const s = STATE;
  const out = document.getElementById('out');

  const mealCards = s.meals.map(m => {
    const r = m.r, sc = m.s;
    const ings = r.ing.map(([name, qty, unit]) => {
      if (qty === null) return name;
      return `${name} — ${fmtQty(qty * sc)} ${unit}`;
    }).join(' · ');

    return `
      <div class="meal">
        <div class="badge">${TITLES[m.key]}${sc !== 1 ? ` ×${sc}` : ''}</div>
        <div class="body">
          <h3>${r.n}</h3>
          <div class="kcal">${Math.round(r.k*sc)} ккал · Б ${Math.round(r.p*sc)} · Ж ${Math.round(r.f*sc)} · У ${Math.round(r.c*sc)}</div>
          <p class="ing">${ings}</p>
          <p class="steps">${r.s}</p>
        </div>
      </div>`;
  }).join('');

  // Список покупок
  const map = new Map();
  s.meals.forEach(m => {
    m.r.ing.forEach(([name, qty, unit]) => {
      if (qty === null) return;
      const key = name + '|' + unit;
      const prev = map.get(key) || { name, unit, qty: 0 };
      prev.qty += qty * m.s;
      map.set(key, prev);
    });
  });
  const shop = [...map.values()]
    .sort((a,b) => a.name.localeCompare(b.name,'ru'))
    .map(i => `<li>${i.name} — ${fmtQty(i.qty)} ${i.unit}</li>`).join('');

  const lossPerWeek = (s.tdee - s.target) * 7 / 7700;

  out.innerHTML = `
    <h2 class="section">Ваши цифры</h2>
    <div class="card">
      <div class="summary">
        <div class="stat"><div class="k">Базовый обмен</div><div class="v">${s.b} <span class="u">ккал</span></div></div>
        <div class="stat"><div class="k">Расход с активностью</div><div class="v">${s.tdee} <span class="u">ккал</span></div></div>
        <div class="stat"><div class="k">Цель на день</div><div class="v" style="color:var(--accent)">${s.target} <span class="u">ккал</span></div></div>
        <div class="stat"><div class="k">Дефицит</div><div class="v">${s.tdee - s.target} <span class="u">ккал</span></div></div>
        <div class="stat"><div class="k">Темп снижения</div><div class="v">${lossPerWeek.toFixed(2)} <span class="u">кг/нед</span></div></div>
      </div>

      <div class="macros">
        <div class="macro"><b>${s.protein} г</b><span>БЕЛКИ · ${s.protein*4} ккал</span></div>
        <div class="macro"><b>${s.fat} г</b><span>ЖИРЫ · ${s.fat*9} ккал</span></div>
        <div class="macro"><b>${s.carbs} г</b><span>УГЛЕВОДЫ · ${s.carbs*4} ккал</span></div>
        <div class="macro"><b>${(s.protein*1.8/ (s.protein||1)).toFixed(1)}</b><span>—</span></div>
      </div>

      ${s.warning ? `<div class="warn">⚠️ ${s.warning}</div>` : ''}
    </div>

    <h2 class="section">Меню на день · ${Math.round(s.totalKcal)} ккал</h2>
    ${mealCards}

    <h2 class="section">Список покупок на день</h2>
    <div class="card"><ul class="shop">${shop}</ul></div>

    <h2 class="section">Что важно помнить</h2>
    <div class="card">
      <ul class="tips">
        <li><b>Вода:</b> 30 мл на кг веса в сутки (для ${s.weight} кг — примерно ${Math.round(s.weight*30/100)*100} мл).</li>
        <li><b>Белок в каждом приёме пищи</b> — он даёт сытость и сохраняет мышцы при дефиците.</li>
        <li><b>Овощи</b> — минимум 400 г в день, они добавляют объём и клетчатку почти без калорий.</li>
        <li><b>Взвешивайте еду</b> первые 2–3 недели: глазомер сильно врёт, особенно с маслом и орехами.</li>
        <li><b>Сон 7–8 часов</b> — при недосыпе растёт аппетит и падает расход энергии.</li>
        <li><b>Силовые тренировки 2–3 раза в неделю</b> помогают терять именно жир, а не мышцы.</li>
        <li>Раз в 1–2 недели пересчитывайте план: чем меньше вес, тем ниже расход.</li>
      </ul>
    </div>

    <div class="actions">
      <button class="secondary" id="regen">🔄 Другое меню</button>
    </div>
  `;

  out.classList.remove('hidden');
  document.getElementById('regen').onclick = regenerate;
  out.scrollIntoView({ behavior:'smooth', block:'start' });
}

function regenerate(){
  const s = STATE;
  if (!s) return;
  const shares = { breakfast:0.27, lunch:0.33, dinner:0.30 };
  const used = [];
  const meals = [];
  for (const key of ['breakfast','lunch','dinner']){
    const p = pick(RECIPES[key], s.target * shares[key], used);
    used.push(p.r.n);
    meals.push({ key, ...p });
  }
  const spent = meals.reduce((a,m) => a + m.r.k * m.s, 0);
  const sp = pick(RECIPES.snack, Math.max(90, s.target - spent), used);
  meals.push({ key:'snack', ...sp });

  STATE.meals = meals;
  STATE.totalKcal = meals.reduce((a,m) => a + m.r.k * m.s, 0);
  render();
}

document.getElementById('go').onclick = buildPlan;
</script>
