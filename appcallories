  .stat{background:#f8fbf9;border:1px solid var(--line);border-radius:14px;padding:14px}
  .stat .k{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px}
  .stat .v{font-size:22px;font-weight:700;margin-top:4px}
  .stat .u{font-size:13px;font-weight:500;color:var(--muted)}

